# Secrets / credentials — never commit
.env
.env.*
.cache-*
config.json
*.pem
credentials*
secrets*

# Personal settings on this Mac (the Pi's address) — never published
mac/local.conf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store

# Runtime files (regenerated by the daemons)
status.json
current.png
config/icloud_status.json

# The slideshow's own pictures stay private
photos/*
!photos/.gitkeep
image/concepts/option1-from-photos/

# Dropbox's duplicates when two computers edit the same file
*conflicted copy*

# Scratch
_to_delete/

# Your settings, written by the control panel. Not code: a missing file means
# all defaults (python/state.py), so updates never touch it.
config/state.json
# What the updater last found (python/updater.py)
config/update.json

# This Pi's own panel settings, read over config/rgb_options.ini; updates never touch it
config/rgb_options.local.ini
