# Lets the Mac's automatic updater restart the services without a password.
# Install on the Pi (this puts in your own username):
#   sed "s/__USER__/$USER/" spotipi-update.sudoers | sudo tee /etc/sudoers.d/spotipi-update >/dev/null
#   sudo chmod 440 /etc/sudoers.d/spotipi-update
#   sudo visudo -c
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart spotipi spotipi-client, /bin/systemctl restart spotipi spotipi-client
